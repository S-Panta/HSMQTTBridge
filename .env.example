# Copy to .env and fill in the required values.
# Leave optional variables commented out to use their defaults (see README);

# HydroServer config
HYDROSERVER_URL=
# required
WORKSPACE_API_KEY=

# MQTT broker config
# MQTT_BROKER_URL=test.mosquitto.org
# MQTT_BROKER_PORT=1883
# Subscribe to every topic of one site:
# MQTT_TOPIC_FILTER=uwrl/#
# ...or every topic of one client:
# MQTT_TOPIC_FILTER=uwrl/client/#
# MQTT_CLIENT_ID=hsmqttbridge
# MQTT_KEEPALIVE=60
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Database (required)
DB_PATH=data/observation.db

# Topics routed to HydroServer
HYDROSERVER_TOPIC_ROUTES=["uwrl/#"]

# Logging level (upper case)
# LOG_LEVEL=INFO

# Retry worker
# MAX_RETRY_ATTEMPT=10
# Seconds between retry runs
# RETRY_INTERVAL=1800
